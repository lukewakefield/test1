---
metadata:
  name: Agency Intro
  tags:
  class: section
  fields:
  - id: index
    type: text
    label: Index
    default: "1"
    richtext: false
  - id: label
    type: text
    label: Label
    default: Introducing the studio
    richtext: false
  - id: heading
    type: textarea
    label: Heading
    default: Strategy-led creatives, delivering results in digital and beyond.
    richtext: false
  - id: body
    type: textarea
    label: Body
    default: Through research, creative thinking and iteration we help growing brands realize their digital full potential.
    richtext: false
  - id: cta_label
    type: text
    label: CTA Label
    default: About our studio
    richtext: false
  - id: cta_url
    type: url
    label: CTA URL
    default: "#studio"
    richtext: false
  - id: image_left
    type: image_picker
    label: Left image
    default:
    richtext: false
  - id: image_right
    type: image_picker
    label: Right image
    default:
    richtext: false
  hide_on: []
  category: content
  requires: []
  settings: []
  collection: agency
  components: []
  updated_at: 1781820001
  collections:
  global_data:
  global_fields: []
---
<section id="studio" class="{{ this.variant }} @container w-full bg-[var(--p-bg-raised)] pt-16 pb-12 @md:pt-20 @md:pb-16 @lg:pt-32 @lg:pb-24" data-motion-group>
  <div class="container !px-5 @md:!px-8 @lg:!px-12">
    <div class="mb-6 flex items-center gap-3 @md:mb-8" data-motion-text>
      <span class="grid h-7 w-7 place-items-center rounded-full bg-[var(--p-ink)] text-[12px] font-semibold text-[var(--p-text-inverse)]">{{ this.index | default: "1" }}</span>
      <span class="rounded-full border border-[var(--p-border-default)] px-3 py-1 text-[12px] font-medium text-[var(--p-text-primary)]">{{ this.label | default: "Introducing the studio" }}</span>
    </div>
    <h2 class="mb-12 max-w-[20em] @lg:mb-28" data-motion-text>{% if this.heading != blank %}{{ this.heading }}{% else %}Strategy-led creatives, delivering results in digital and beyond.{% endif %}</h2>
    {% assign intro_left = this.image_left %}
    {% if intro_left == blank %}
      {% assign intro_left = "library/studiokit/ai/home/person-using-macbook-pro-on-brown-wooden-table-5244002.jpeg" %}
    {% endif %}
    {% assign intro_right = this.image_right %}
    {% if intro_right == blank %}
      {% assign intro_right = "library/studiokit/ai/home/focused-male-architect-drawing-scheme-on-whiteboard-in-office-4463585.jpeg" %}
    {% endif %}
    <div class="grid items-end gap-6 @lg:grid-cols-[24%_minmax(0,1fr)_44%] @lg:gap-8">
      <div class="overflow-hidden rounded-2xl bg-[var(--p-bg-well)] aspect-[4/5] [&_img]:h-full [&_img]:w-full [&_img]:object-cover" data-motion-text>
        {% include 'img', path: intro_left, layout: 'default/lg', classes: 'block h-full w-full object-cover', attributes: 'alt="" loading="lazy"' %}
      </div>
      <div class="flex flex-col items-start gap-6 py-2" data-motion-text>
        <p class="max-w-[17rem] text-[15px] leading-relaxed">{{ this.body | default: "Through research, creative thinking and iteration we help growing brands realize their digital full potential." }}</p>
        <a href="{{ this.cta_url | default: '#' }}" class="button-secondary group">
          <span class="block h-5 overflow-hidden">
            <span class="flex flex-col transition-transform duration-500 ease-[cubic-bezier(0.25,0.1,0.25,1)] group-hover:-translate-y-1/2">
              <span class="block h-5 leading-5">{{ this.cta_label | default: "About our studio" }}</span>
              <span class="block h-5 leading-5" aria-hidden="true">{{ this.cta_label | default: "About our studio" }}</span>
            </span>
          </span>
          <span class="grid h-8 w-8 place-items-center rounded-full border border-[var(--p-action-primary)] text-[var(--p-action-primary)]">
            <span class="material-symbols-outlined text-[18px] leading-none" aria-hidden="true">arrow_forward</span>
          </span>
        </a>
      </div>
      <div class="overflow-hidden rounded-2xl bg-[var(--p-bg-well)] aspect-[4/3] [&_img]:h-full [&_img]:w-full [&_img]:object-cover" data-motion-text>
        {% include 'img', path: intro_right, layout: 'default/lg', classes: 'block h-full w-full object-cover', attributes: 'alt="" loading="lazy"' %}
      </div>
    </div>
  </div>
</section>
