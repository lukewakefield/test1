---
metadata:
  name: Basecoat Showcase
  tags:
  class: section
  fields:
  - id: heading
    type: text
    label: Heading
    default: All of the component system, none of the React.
    richtext: false
  - id: intro
    type: textarea
    label: Introduction
    default: This page is built with Basecoat markup. Buttons, fields, menus, and overlays use the Vega stylesheet.
    richtext: false
  hide_on: []
  category: content
  requires: []
  settings: []
  collection: basecoat
  components: []
  updated_at: 1781824000
  collections:
  global_data:
  global_fields: []
---
<div class="{{ this.variant }} bc-main @container min-h-svh">
  <div class="mx-auto flex w-full max-w-3xl flex-col gap-14 px-6 py-10 @md:px-10 @md:py-14">

    <header id="bc-intro" class="flex flex-col gap-4">
      <p class="eyebrow_text">Basecoat</p>
      <h1 class="max-w-[16ch]">{% if this.heading != blank %}{{ this.heading }}{% else %}All of the component system, none of the React.{% endif %}</h1>
      <p>{% if this.intro != blank %}{{ this.intro }}{% else %}This page is built with Basecoat markup.{% endif %}</p>
      <div class="flex flex-wrap items-center gap-2">
        <a class="btn" href="https://basecoatui.com/">Get started</a>
        <a class="btn" data-variant="outline" href="https://basecoatui.com/installation/">Installation</a>
        <span class="badge">Vega</span>
        <span class="badge" data-variant="secondary">v1.0.2</span>
        <span class="badge" data-variant="outline">CSS</span>
      </div>
    </header>

    <section id="bc-buttons" class="flex flex-col gap-4">
      <h2>Buttons</h2>
      <div class="flex flex-wrap items-center gap-2">
        <button type="button" class="btn">Primary</button>
        <button type="button" class="btn" data-variant="secondary">Secondary</button>
        <button type="button" class="btn" data-variant="outline">Outline</button>
        <button type="button" class="btn" data-variant="ghost">Ghost</button>
        <button type="button" class="btn" data-variant="destructive">Destructive</button>
        <button type="button" class="btn" data-variant="link">Link</button>
      </div>
      <div class="flex flex-wrap items-center gap-2">
        <button type="button" class="btn" data-size="xs">Extra small</button>
        <button type="button" class="btn" data-size="sm">Small</button>
        <button type="button" class="btn">Default</button>
        <button type="button" class="btn" data-size="lg">Large</button>
        <button type="button" class="btn" disabled>Disabled</button>
      </div>
    </section>

    <section id="bc-badges" class="flex flex-col gap-4">
      <h2>Badges</h2>
      <div class="flex flex-wrap gap-2">
        <span class="badge">Badge</span>
        <span class="badge" data-variant="secondary">Secondary</span>
        <span class="badge" data-variant="destructive">Destructive</span>
        <span class="badge" data-variant="outline">Outline</span>
      </div>
      <div class="flex items-center gap-3">
        <span class="avatar"><span>BC</span></span>
        <span class="avatar"><span>UI</span></span>
      </div>
    </section>

    <section id="bc-cards" class="flex flex-col gap-4">
      <h2>Card</h2>
      <div class="card">
        <header>
          <h3>Login to your account</h3>
          <p>Enter your email below to continue.</p>
        </header>
        <section>
          <form class="grid gap-4" action="#" method="post">
            <div class="grid gap-2">
              <label class="label" for="bc-email">Email</label>
              <input class="input" type="email" id="bc-email" placeholder="m@example.com">
            </div>
            <div class="grid gap-2">
              <label class="label" for="bc-password">Password</label>
              <input class="input" type="password" id="bc-password" placeholder="Password">
            </div>
            <button type="button" class="btn">Continue</button>
          </form>
        </section>
      </div>
    </section>

    <section id="bc-forms" class="flex flex-col gap-4">
      <h2>Forms</h2>
      <fieldset class="fieldset">
        <legend>Profile</legend>
        <div role="group" class="field">
          <label for="bc-name">Full name</label>
          <input class="input" id="bc-name" placeholder="Ada Lovelace">
        </div>
        <div role="group" class="field" data-invalid>
          <label for="bc-username">Username</label>
          <input class="input" id="bc-username" aria-invalid="true" aria-describedby="bc-username-error" value="ada">
          <p id="bc-username-error" role="alert">Choose another username.</p>
        </div>
        <div role="group" class="field" data-orientation="horizontal">
          <input type="checkbox" id="bc-terms" class="input">
          <label for="bc-terms">Accept terms and conditions</label>
        </div>
        <div role="group" class="field" data-orientation="horizontal">
          <input type="checkbox" id="bc-switch" role="switch" class="input" checked>
          <label for="bc-switch">Email notifications</label>
        </div>
        <div class="grid gap-2">
          <label class="label" for="bc-notes">Notes</label>
          <textarea class="textarea" id="bc-notes" placeholder="Add a note"></textarea>
        </div>
      </fieldset>
      <div id="bc-select" class="select" data-placeholder="Select a fruit">
        <button type="button" class="w-56" id="bc-select-trigger" aria-haspopup="listbox" aria-expanded="false" aria-controls="bc-select-listbox">
          <span class="truncate">Select a fruit</span>
        </button>
        <div id="bc-select-popover" data-popover aria-hidden="true">
          <div role="listbox" id="bc-select-listbox" aria-orientation="vertical" aria-labelledby="bc-select-trigger">
            <div role="option" data-value="apple">Apple</div>
            <div role="option" data-value="orange">Orange</div>
            <div role="option" data-value="pear">Pear</div>
          </div>
        </div>
        <input type="hidden" name="fruit" value="">
      </div>
    </section>

    <section id="bc-feedback" class="flex flex-col gap-4">
      <h2>Feedback</h2>
      <div class="alert">
        <h3>Payment successful</h3>
        <section>Your payment has been processed.</section>
      </div>
      <div class="alert" data-variant="destructive">
        <h3>Something went wrong</h3>
        <section>Check the form and try again.</section>
      </div>
      <div class="progress" role="progressbar" aria-label="Loading" aria-valuenow="66" aria-valuemin="0" aria-valuemax="100">
        <span style="width: 66%"></span>
      </div>
      <section class="accordion">
        <details open>
          <summary>What are the shipping options?</summary>
          <section>Standard, express, and overnight.</section>
        </details>
        <details>
          <summary>What is the return policy?</summary>
          <section>Returns are accepted within 30 days.</section>
        </details>
      </section>
    </section>

    <section id="bc-overlays" class="flex flex-col gap-4">
      <h2>Overlays</h2>
      <div class="flex flex-wrap gap-2">
        <button type="button" class="btn" data-variant="outline" onclick="document.getElementById('bc-dialog').showModal()">Share</button>
        <button type="button" class="btn" data-variant="outline" onclick="document.getElementById('bc-alert-dialog').showModal()">Delete</button>
      </div>
      <dialog id="bc-dialog" class="dialog" aria-labelledby="bc-dialog-title">
        <div>
          <header>
            <h2 id="bc-dialog-title">Share link</h2>
            <p>Anyone with this link can view it.</p>
          </header>
          <section>
            <input class="input" type="text" value="https://example.com/share" readonly>
          </section>
          <footer>
            <button type="button" class="btn" data-variant="outline" onclick="this.closest('dialog').close()">Close</button>
          </footer>
        </div>
      </dialog>
      <dialog id="bc-alert-dialog" class="alert-dialog" aria-labelledby="bc-alert-title">
        <div>
          <header>
            <h2 id="bc-alert-title">Are you sure?</h2>
            <p>This action cannot be undone.</p>
          </header>
          <footer>
            <button type="button" class="btn" data-variant="outline" onclick="this.closest('dialog').close()">Cancel</button>
            <button type="button" class="btn" data-variant="destructive" onclick="this.closest('dialog').close()">Continue</button>
          </footer>
        </div>
      </dialog>
      <div id="bc-menu" class="dropdown-menu">
        <button type="button" id="bc-menu-trigger" class="btn" data-variant="outline" aria-haspopup="menu" aria-controls="bc-menu-list" aria-expanded="false">Open menu</button>
        <div id="bc-menu-popover" data-popover aria-hidden="true">
          <div role="menu" id="bc-menu-list" aria-labelledby="bc-menu-trigger">
            <div role="menuitem">Profile</div>
            <div role="menuitem">Billing</div>
            <div role="menuitem">Sign out</div>
          </div>
        </div>
      </div>
    </section>

    <section id="bc-data" class="flex flex-col gap-4">
      <h2>Data</h2>
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <ol>
          <li><a href="#bc-intro">Home</a></li>
          <li aria-hidden="true">/</li>
          <li><a href="#bc-data">Components</a></li>
          <li aria-hidden="true">/</li>
          <li>Table</li>
        </ol>
      </nav>
      <div class="tabs" id="bc-tabs">
        <nav role="tablist" aria-orientation="horizontal">
          <button type="button" role="tab" id="bc-tab-overview" aria-controls="bc-panel-overview" aria-selected="true">Overview</button>
          <button type="button" role="tab" id="bc-tab-activity" aria-controls="bc-panel-activity" aria-selected="false" tabindex="-1">Activity</button>
        </nav>
        <div role="tabpanel" id="bc-panel-overview" aria-labelledby="bc-tab-overview">Recent records for this workspace.</div>
        <div role="tabpanel" id="bc-panel-activity" aria-labelledby="bc-tab-activity" hidden>No new activity.</div>
      </div>
      <div class="table-container">
        <table class="table">
          <thead>
            <tr>
              <th>Name</th>
              <th>Status</th>
              <th>Amount</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>North studio</td>
              <td><span class="badge" data-variant="secondary">Active</span></td>
              <td>1,284.00</td>
            </tr>
            <tr>
              <td>Archive</td>
              <td><span class="badge" data-variant="outline">Paused</span></td>
              <td>320.00</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

  </div>
</div>
