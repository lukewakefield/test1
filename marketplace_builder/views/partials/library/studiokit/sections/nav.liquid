---
metadata:
  name: Navigation
  tags:
  class: section
  lists:
  - name: Nav Links
    type: ui_kit_nav_links
    fields:
    - id: link_text
      type: text
      label: Link Text
      default: Features
      richtext: false
    - id: link_url
      type: url
      label: Link URL
      default: "#"
      richtext: false
  - name: Secondary Links
    type: ui_kit_nav_secondary_links
    fields:
    - id: link_text
      type: text
      label: Link Text
      default: Contact Us
      richtext: false
    - id: link_url
      type: url
      label: Link URL
      default: "#"
      richtext: false
  fields:
  - id: logo_image
    type: image_picker
    label: Logo Image
    default:
    richtext: false
  - id: logo_image_alt
    type: text
    label: Logo Image Alt Text
    default: Site logo
    richtext: false
  - id: logo_text
    type: text
    label: Logo Text
    default: ''
    richtext: false
  - id: cta_label
    type: text
    label: CTA Button Label
    default: Book a strategy call
    richtext: false
  - id: cta_url
    type: url
    label: CTA Button URL
    default: "#"
    richtext: false
  - id: note
    type: text
    label: Availability note
    default: Taking on projects for Q1 2026
    richtext: false
  - id: secondary_cta_label
    type: text
    label: Secondary CTA Label
    default: ''
    richtext: false
  - id: secondary_cta_url
    type: url
    label: Secondary CTA URL
    default: "#"
    richtext: false
  - id: show_dark_mode_toggle
    type: boolean
    label: Show Dark Mode Toggle
    default:
    richtext: false
  - id: default_theme
    type: select
    label: Default Theme
    default: light
    options:
    - label: Auto (System Preference)
      value: auto
    - label: Light
      value: light
    - label: Dark
      value: dark
    richtext: false
  hide_on: []
  category: headers
  requires: []
  settings: []
  collection: studiokit
  components: []
  updated_at: 1781817172
  collections:
  global_data:
  global_fields: []
---
<nav
  class="@container sticky top-0 z-50 w-full px-2 py-2 @md:px-3 @md:py-3"
  data-ui-kit-nav
  data-default-theme="{{ this.default_theme | default: 'light' }}"
>
<div class="mx-auto flex w-full max-w-[90rem] items-center justify-between gap-4 rounded-full bg-[var(--p-bg-raised)] py-[5px] pl-4 pr-[5px] @md:pl-5">
    <div class="flex min-w-0 items-center gap-6">
      <a href="/" class="flex items-center !overflow-visible" aria-label="Home">
        {% if this.logo_image != blank %}
        {% capture logo_image_attributes %}alt="{{ this.logo_image_alt | default: this.logo_text | default: 'Site logo' }}" loading="eager"{% endcapture %}
        {% include 'img', path: this.logo_image, layout: 'default/base', classes: 'h-8 w-auto max-w-[11rem] object-contain !overflow-visible', attributes: logo_image_attributes %}
        {% else %}
        <span class="grid h-8 w-8 place-items-center rounded-full bg-[var(--p-ink)] text-sm font-semibold text-[var(--p-text-inverse)]" aria-hidden="true">H</span>
        {% endif %}
        {% if this.logo_text != blank %}
        <span class="ml-2 truncate text-[15px] font-semibold tracking-tight text-[var(--p-text-primary)]">{{ this.logo_text }}</span>
        {% endif %}
      </a>
      <div class="hidden items-center gap-5 text-[14px] text-[var(--p-text-primary)] @md:flex">
        {% for item in lists.ui_kit_nav_links %}
        <a href="{{ item.link_url }}" class="transition-colors duration-300 hover:text-[var(--p-text-tertiary)]" data-studio-list="{{ item._list }}">{{ item.link_text }}</a>
        {% endfor %}
      </div>
    </div>

    <div class="hidden items-center gap-4 @md:flex">
      {% if this.note != blank %}
      <span class="text-[13px] text-[var(--p-text-tertiary)]">{{ this.note }}</span>
      {% endif %}
      {% if this.show_dark_mode_toggle %}
      <button type="button" aria-label="Cycle color theme" data-theme-toggle class="inline-flex h-9 w-9 items-center justify-center rounded-full text-[var(--p-text-tertiary)]">
        <span data-theme-toggle-icon class="material-symbols-outlined block text-[20px] leading-none" aria-hidden="true">dark_mode</span>
      </button>
      {% endif %}
      <a href="{{ this.cta_url }}" class="button-ink group">
        <span class="block h-5 overflow-hidden">
          <span class="flex flex-col transition-transform duration-500 ease-[cubic-bezier(0.25,0.1,0.25,1)] group-hover:-translate-y-1/2">
            <span class="block h-5 leading-5">{{ this.cta_label }}</span>
            <span class="block h-5 leading-5" aria-hidden="true">{{ this.cta_label }}</span>
          </span>
        </span>
        <span class="grid h-8 w-8 place-items-center rounded-full bg-[var(--p-bg-raised)] text-[var(--p-ink)]">
          <span class="material-symbols-outlined text-[18px] leading-none" aria-hidden="true">arrow_forward</span>
        </span>
      </a>
    </div>

    <button
      type="button"
      data-collapse-toggle="navbar-menu"
      aria-controls="navbar-menu"
      aria-expanded="false"
      class="inline-flex h-9 w-9 items-center justify-center rounded-full @md:hidden">
      <span class="sr-only">Open main menu</span>
      <span class="material-symbols-outlined text-[22px] leading-none" aria-hidden="true">menu</span>
    </button>
</div>

    <div class="hidden" id="navbar-menu" data-collapse-target>
        <div class="px-6 lg:px-10 py-4 md:hidden border-t border-base-400/40">
            <div class="flex flex-col gap-4">
                <div class="space-y-2">
                    {% for item in lists.ui_kit_nav_links %}
                    <a 
                      href="{{ item.link_url }}" 
                      class="block rounded-lg px-3 py-2 text-sm font-medium text-[var(--p-text-primary)] transition-colors hover:bg-[var(--p-fill-hover)]" 
                      data-studio-list="{{ item._list }}">
                        {{ item.link_text }}
                    </a>
                    {% endfor %}
                </div>
                
                <div class="pt-2 border-t border-base-400/40 space-y-2">
                    {% for item in lists.ui_kit_nav_secondary_links %}
                    <a href="{{ item.link_url }}" class="block rounded-lg px-3 py-2 text-sm font-medium text-[var(--p-text-primary)] transition-colors hover:bg-[var(--p-fill-hover)]">{{ item.link_text }}</a>
                    {% endfor %}
                  <a href="{{ this.cta_url }}" class="button inline-flex">{{ this.cta_label }}</a>
                </div>
            </div>
        </div>
    </div>
</nav>

<script>
(function () {
  document.querySelectorAll('[data-ui-kit-nav]').forEach(function (nav) {
    if (nav.dataset.uiKitReady === 'true') return;

    var toggle = nav.querySelector('[data-theme-toggle]');
    var icon = nav.querySelector('[data-theme-toggle-icon]');
    var defaultTheme = nav.getAttribute('data-default-theme') || 'light';

    var THEME_CYCLE = ['light', 'dark', 'auto'];
    var THEME_ICONS = { light: 'light_mode', dark: 'dark_mode', auto: 'brightness_auto' };
    var THEME_LABELS = { light: 'Light theme', dark: 'Dark theme', auto: 'System preference' };

    function applyTheme(theme) {
      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      } else if (theme === 'light') {
        document.documentElement.classList.remove('dark');
      } else {
        // Auto: always follow system preference
        if (
          window.matchMedia &&
          window.matchMedia('(prefers-color-scheme: dark)').matches
        ) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      }
    }

    function syncControls(theme) {
      if (icon) {
        icon.textContent = THEME_ICONS[theme] || THEME_ICONS.light;
      }

      if (toggle) {
        toggle.setAttribute('aria-label', 'Switch color theme (currently ' + (THEME_LABELS[theme] || theme) + ')');
      }
    }

    // Initial theme
    var currentTheme = localStorage.getItem('color-theme') || defaultTheme;

    if (THEME_CYCLE.indexOf(currentTheme) === -1) {
      currentTheme = 'light';
    }

    applyTheme(currentTheme);
    syncControls(currentTheme);

    if (toggle && icon) {
      toggle.addEventListener('click', function () {
        var nextIndex = (THEME_CYCLE.indexOf(currentTheme) + 1) % THEME_CYCLE.length;
        currentTheme = THEME_CYCLE[nextIndex];

        applyTheme(currentTheme);
        localStorage.setItem('color-theme', currentTheme);
        syncControls(currentTheme);
      });
    }

    if (window.matchMedia) {
      var mediaQuery = window.matchMedia('(prefers-color-scheme: dark)');

      function handleSystemThemeChange() {
        if (currentTheme === 'auto') {
          applyTheme('auto');
        }
      }

      if (mediaQuery.addEventListener) {
        mediaQuery.addEventListener('change', handleSystemThemeChange);
      } else {
        mediaQuery.addListener(handleSystemThemeChange);
      }
    }

    if (typeof window.initFlowbite === 'function') {
      window.initFlowbite();
    }

    nav.dataset.uiKitReady = 'true';
  });
})();
</script>