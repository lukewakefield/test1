        <h1 class="mb-3">Selection Controls</h1>
        <p class="mb-8">A selected row is a neutral fill plus one accent mark.</p>
        <div class="ds-row">
          <span class="h-2 w-2 flex-none rounded-full border border-[var(--p-border-strong)]"></span>
          <span class="text-[var(--p-text-primary)]">Unselected row</span>
        </div>
        <div class="ds-row is-selected">
          <span class="ds-mark" aria-hidden="true"></span>
          <span class="text-[var(--p-text-primary)]">Selected row</span>
        </div>
      </article>

      <article data-ds-panel="labeling" hidden>
        <p class="ds-label mb-3">Components</p>
        <h1 class="mb-3">Tags, Badges &amp; Avatars</h1>
        <p class="mb-8">Status color stays on the badge. Avatars stay neutral.</p>
        <div class="flex flex-wrap items-center gap-3">
          <span class="grid h-8 w-8 place-items-center rounded-full bg-[var(--p-bg-well)] text-[12px] font-semibold text-[var(--p-text-primary)]">AK</span>
          <span class="rounded-md bg-[var(--p-success-bg)] px-2 py-1 text-[12px] font-medium text-[var(--p-success-text)]">Active</span>
          <span class="rounded-md bg-[var(--p-warning-bg)] px-2 py-1 text-[12px] font-medium text-[var(--p-warning-text)]">Review</span>
          <span class="rounded-md bg-[var(--p-danger-bg)] px-2 py-1 text-[12px] font-medium text-[var(--p-danger-text)]">Failed</span>
          <span class="rounded-md border border-[var(--p-border-default)] px-2 py-1 text-[12px] font-medium text-[var(--p-text-secondary)]">Draft</span>
        </div>
      </article>

      <article data-ds-panel="data" hidden>
        <p class="ds-label mb-3">Components</p>
        <h1 class="mb-3">Tables &amp; Lists</h1>
        <p class="mb-8">Records use tabular figures. An empty list says what is missing.</p>
        <div class="ds-panel overflow-hidden">
          <div class="flex items-center justify-between border-b border-[var(--p-border-subtle)] px-4 py-3">
            <span class="text-[13px] font-medium text-[var(--p-text-primary)]">North studio</span>
            <span class="ds-stat text-[13px] text-[var(--p-text-secondary)]">12</span>
          </div>
          <div class="flex items-center justify-between border-b border-[var(--p-border-subtle)] px-4 py-3">
            <span class="text-[13px] font-medium text-[var(--p-text-primary)]">Archive</span>
            <span class="ds-stat text-[13px] text-[var(--p-text-secondary)]">3</span>
          </div>
          <div class="px-4 py-6">
            <p class="ds-meta">No records in this view.</p>
          </div>
        </div>
      </article>

      <article data-ds-panel="feedback" hidden>
        <p class="ds-label mb-3">Components</p>
        <h1 class="mb-3">Feedback</h1>
        <p class="mb-8">Success, warning, and danger each have their own color. The accent is not an error.</p>
        <div class="flex flex-col gap-2">
          <p class="!m-0 rounded-md bg-[var(--p-success-bg)] px-3 py-2 !text-[13px] !text-[var(--p-success-text)]">Saved.</p>
          <p class="!m-0 rounded-md bg-[var(--p-warning-bg)] px-3 py-2 !text-[13px] !text-[var(--p-warning-text)]">Review before publishing.</p>
          <p class="!m-0 rounded-md bg-[var(--p-danger-bg)] px-3 py-2 !text-[13px] !text-[var(--p-danger-text)]">Could not save this record.</p>
        </div>
      </article>

      <article data-ds-panel="overlays" hidden>
        <p class="ds-label mb-3">Components</p>
        <h1 class="mb-3">Overlays &amp; Menus</h1>
        <p class="mb-8">Menus and dialogs sit on a raised surface. Dark is the same components with the tokens swapped.</p>
        <div class="ds-panel mb-4 w-56 p-1">
          <p class="!m-0 rounded-md px-2 py-1.5 !text-[13px] !text-[var(--p-text-primary)]">Rename</p>
          <p class="!m-0 rounded-md bg-[var(--p-fill-selected)] px-2 py-1.5 !text-[13px] !text-[var(--p-text-primary)]">Duplicate</p>
          <p class="!m-0 rounded-md px-2 py-1.5 !text-[13px] !text-[var(--p-danger-text)]">Delete</p>
        </div>
        <div class="ds-darkframe flex flex-col gap-3">
          <p class="ds-label">Dark swap</p>
          <p class="!text-[var(--p-text-primary)]">Same components. The tokens change.</p>
          <div class="flex flex-wrap items-center gap-3">
            <button type="button" class="button">Save</button>
            <button type="button" class="button-secondary">Cancel</button>
            <span class="ds-mark" aria-hidden="true"></span>
          </div>
        </div>
      </article>

    </div>
  </div>
  </div>
</section>
<script>
(function () {
  var root = document.querySelector("[data-ds-docs]");
  if (!root || root.getAttribute("data-ds-ready")) return;
  root.setAttribute("data-ds-ready", "1");
  document.documentElement.classList.add("ds-docs");

  var links = root.querySelectorAll("[data-ds-link]");
  var panels = root.querySelectorAll("[data-ds-panel]");

  function idFromHash() {
    var id = (location.hash || "#overview").replace("#", "");
    return root.querySelector('[data-ds-panel="' + id + '"]') ? id : "overview";
  }

  function show(id) {
    panels.forEach(function (panel) {
      panel.hidden = panel.getAttribute("data-ds-panel") !== id;
    });
    links.forEach(function (link) {
      var on = link.getAttribute("data-ds-link") === id;
      link.classList.toggle("is-active", on);
      if (on) link.setAttribute("aria-current", "page");
      else link.removeAttribute("aria-current");
    });
  }

  root.addEventListener("click", function (event) {
    var link = event.target.closest("[data-ds-link]");
    if (!link || !root.contains(link)) return;
    event.preventDefault();
    var id = link.getAttribute("data-ds-link");
    if (location.hash !== "#" + id) history.pushState(null, "", "#" + id);
    show(id);
    window.scrollTo(0, 0);
  });

  window.addEventListener("hashchange", function () {
    show(idFromHash());
  });

  window.addEventListener("popstate", function () {
    show(idFromHash());
  });

  show(idFromHash());
})();
</script>
