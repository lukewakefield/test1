---
metadata:
  name: Navigation - Ecommerce
  tags:
  class: section
  lists:
  - name: Nav Links
    type: ui_kit_nav_links
    fields:
    - id: link_text
      type: text
      label: Link Text
      default: Features
    - id: link_url
      type: url
      label: Link URL
      default: "#"
  - name: Secondary Links
    type: ui_kit_nav_secondary_links
    fields:
    - id: link_text
      type: text
      label: Link Text
      default: Contact Us
    - id: link_url
      type: url
      label: Link URL
      default: "#"
  fields:
  - id: logo_image
    type: image_picker
    label: Logo Image
  - id: logo_image_alt
    type: text
    label: Logo Image Alt Text
    default: Site logo
  - id: logo_text
    type: text
    label: Logo Text
    default: ''
  - id: cta_label
    type: text
    label: CTA Button Label
    default: Start Free Trial
  - id: cta_url
    type: url
    label: CTA Button URL
    default: "#"
  - id: show_cart
    type: boolean
    label: Show Cart
    default: true
  - id: cart_label
    type: text
    label: Cart Label
    default: View Cart
  - id: cart_url
    type: url
    label: Cart URL
    default: "#"
  - id: show_quote
    type: boolean
    label: Show Quote List
    default: true
  - id: quote_label
    type: text
    label: Quote List Label
    default: View Quote List
  - id: quote_url
    type: url
    label: Quote List URL
    default: "/quotes"
  - id: show_profile
    type: boolean
    label: Show Profile Link
    default: true
  - id: profile_label
    type: text
    label: Profile Link Label
    default: My Account
  - id: profile_url
    type: url
    label: Profile Link URL
    default: "/dashboard"
  - id: show_dark_mode_toggle
    type: boolean
    label: Show Dark Mode Toggle
  - id: default_theme
    type: select
    label: Default Theme
    default: light
    options:
    - label: Auto (System Preference)
      value: auto
    - label: Light
      value: light
    - label: Dark
      value: dark
  hide_on: []
  category: headers
  collection: studiokit
---
{%- comment -%} Cart parsing {%- endcomment -%}
{% assign cart_parsed = context.session.cart | parse_json %}
{% assign cart_quantity = 0 %}
{% if cart_parsed %}
  {% for item in cart_parsed %}
    {% assign cart_quantity = cart_quantity | plus: item[1].quantity %}
  {% endfor %}{% endif %}

{%- comment -%} Quote list parsing (webapp_2) {%- endcomment -%}
{% assign quote_items_json = "[]" %}
{% if context.session.quote_record_id != blank %}
  {% graphql quote_g
    , table: "webapp_2"
    , id: context.session.quote_record_id %}
    query quote_g($table: String!, $id: ID!) {    
      records(per_page: 1, filter: { table: { value: $table }, id: { value: $id } }) {
        results {
          items_json: property(name: "webapp_field_2_1")
          status: property(name: "webapp_field_2_2")
        }
      }
    }
  {% endgraphql %}
  {% assign quote_items_raw = quote_g.records.results[0].items_json %}
  {% if quote_items_raw != blank and quote_g.records.results[0].status == "In Progress" %}
    {% assign quote_items_json = quote_items_raw %}
  {% endif %}
{% endif %}
{% assign quote_items_parsed = quote_items_json | parse_json %}
{% assign quote_quantity = 0 %}
{% for item in quote_items_parsed %}
  {% assign quote_quantity = quote_quantity | plus: item.qty %}
{% endfor %}

<script>
  window.__quoteItems = {{ quote_items_json | default: '[]' | html_safe }};
</script>

{%- comment -%} Siteglide ecommerce helper script (from Site Fusion) {%- endcomment -%}
<script src="{{ 'modules/siteglide_ecommerce/js/siteglide_ecommerce.js' | asset_url }}"></script>

<div class="w-full bg-primary text-center py-2 relative z-40">
  <a href="#" class="text-xs font-medium text-white dark:text-neutral-50 hover:text-indigo-100 dark:hover:text-neutral-200 tracking-wide inline-flex items-center gap-1">
    Announcements or promo text goes here. Learn more
    <span class="material-symbols-outlined mt-[1px] text-[14px] leading-none">arrow_forward</span>
  </a>
</div>

<nav
  class="@container sticky top-0 bg-base-100 dark:bg-base-950 backdrop-blur-xl z-50 border border-base-400/40 w-full mx-auto min-[2560px]:max-w-[130rem]"
  data-ui-kit-nav
  data-default-theme="{{ this.default_theme | default: 'light' }}">

  <div class="px-6 lg:px-10 py-5 flex justify-between items-center md:grid md:grid-cols-[1fr_auto_1fr] md:items-center md:gap-8">
    <div class="flex items-center gap-3 min-w-0 !overflow-visible">
      <a
        href="/"
        class="flex items-center !overflow-visible"
        aria-label="Home">
        {% if this.logo_image != blank %}
          {% capture logo_image_attributes %}alt="{{ this.logo_image_alt | default: this.logo_text | default: 'Site logo' }}" loading="eager"{% endcapture %}
          {% include 'img'
            , path: this.logo_image
            , layout: 'default/base'
            , classes: 'h-8 w-auto max-w-[10rem] object-contain !overflow-visible'
            , attributes: logo_image_attributes %}
        {% else %}
          <span class="material-symbols-outlined text-2xl text-neutral-900 dark:text-neutral-50 rotate-90" aria-hidden="true">segment</span>
        {% endif %}
        {% if this.logo_text != blank %}
          <span class="ml-2 text-lg md:text-xl font-extrabold tracking-tight text-neutral-900 dark:text-neutral-50 truncate">{{ this.logo_text }}</span>
        {% endif %}
      </a>
    </div>

    <div class="hidden md:flex items-center gap-8 justify-center">
      <div class="flex items-center gap-8 text-sm font-medium text-neutral-900 dark:text-neutral-50">
        {% for item in lists.ui_kit_nav_links %}
          <a
            href="{{ item.link_url }}"
            class="hover:text-neutral-700 dark:hover:text-neutral-200 transition-colors"
            data-studio-list="{{ item._list }}">{{ item.link_text }}</a>
        {% endfor %}
      </div>
    </div>

    <div class="hidden md:flex items-center justify-end gap-6">
      {% if this.show_dark_mode_toggle %}
        <button
          type="button"
          aria-label="Cycle color theme"
          data-theme-toggle
          class="button-secondary inline-flex items-center justify-center text-neutral-500 dark:text-neutral-400">
          <span
            data-theme-toggle-icon
            class="material-symbols-outlined block h-5 w-5 text-[20px] leading-none text-center"
            aria-hidden="true">dark_mode</span>
        </button>
      {% endif %}

      {% for item in lists.ui_kit_nav_secondary_links %}
        <a href="{{ item.link_url }}" class="hidden md:block text-sm font-medium text-neutral-500 dark:text-neutral-400 hover:text-neutral-700 dark:hover:text-neutral-50 transition-colors">{{ item.link_text }}</a>
      {% endfor %}

      {% if this.show_cart %}
        <a href="{{ this.cart_url }}" class="inline-flex items-center gap-2 text-sm font-medium text-neutral-700 dark:text-neutral-200 hover:text-neutral-900">
          <span class="material-symbols-outlined">shopping_cart</span>
          <span aria-live="polite" data-s-e-live-cart-quantity>{{ cart_quantity }}</span>
          <span class="sr-only">items in cart</span>
        </a>
      {% endif %}

      {% comment %} {% if this.show_quote %}
                                        <a href="{{ this.quote_url }}" class="hidden md:inline-flex items-center gap-2 text-sm font-medium text-neutral-700 dark:text-neutral-200 hover:text-neutral-900">
                                          <span class="material-symbols-outlined">request_quote</span>
                                          <span data-quote-list-quantity aria-live="polite">{{ quote_quantity }}</span>
                                        </a>
                              {% endif %} {% endcomment %}


      {% if this.show_profile %}
        <a href="{{ this.profile_url }}" class="hidden md:inline-flex items-center gap-2 text-sm font-medium text-neutral-700 dark:text-neutral-200 hover:text-neutral-900">
          <span class="material-symbols-outlined">person</span>
        </a>
      {% endif %}

      <a href="{{ this.cta_url }}" class="button hidden md:inline-flex">{{ this.cta_label }}</a>
    </div>

    <button
      type="button"
      data-collapse-toggle="navbar-menu"
      aria-controls="navbar-menu"
      aria-expanded="false"
      class="button-secondary inline-flex items-center gap-1 md:hidden">
      <span class="sr-only">Open main menu</span>
      <span class="material-symbols-outlined w-6 h-6 text-[24px] leading-none" aria-hidden="true">menu</span>
    </button>
  </div>

  <div
    class="hidden"
    id="navbar-menu"
    data-collapse-target>
    <div class="px-6 lg:px-10 py-4 md:hidden border-t border-base-400/40">
      <div class="flex flex-col gap-4">
        <div class="space-y-2">
          {% for item in lists.ui_kit_nav_links %}
            <a
              href="{{ item.link_url }}"
              class="block rounded-lg px-3 py-2 text-sm font-medium text-neutral-900 transition-colors hover:bg-neutral-200 dark:text-neutral-50 dark:hover:bg-neutral-800"
              data-studio-list="{{ item._list }}">{{ item.link_text }}</a>
          {% endfor %}
        </div>

        <div class="pt-2 border-t border-base-400/40 space-y-2">
          {% for item in lists.ui_kit_nav_secondary_links %}
            <a href="{{ item.link_url }}" class="block rounded-lg px-3 py-2 text-sm font-medium text-neutral-900 transition-colors hover:bg-neutral-200 dark:text-neutral-50 dark:hover:bg-neutral-800">{{ item.link_text }}</a>
          {% endfor %}

          {% if this.show_cart %}
            <a href="{{ this.cart_url }}" class="block rounded-lg px-3 py-2 text-sm font-medium text-neutral-900 transition-colors hover:bg-neutral-200">{{ cart_quantity }} item(s) in cart · {{ this.cart_label }}</a>
          {% endif %}

          {% if this.show_quote %}
            <a href="{{ this.quote_url }}" class="block rounded-lg px-3 py-2 text-sm font-medium text-neutral-900 transition-colors hover:bg-neutral-200">{{ quote_quantity }} item(s) in quote list · {{ this.quote_label }}</a>
          {% endif %}

          <a href="{{ this.cta_url }}" class="button inline-flex">{{ this.cta_label }}</a>
        </div>
      </div>
    </div>
  </div>

</nav>

<script>
  (function () {
  document.querySelectorAll('[data-ui-kit-nav]').forEach(function (nav) {
    if (nav.dataset.uiKitReady === 'true') return;

    var toggle = nav.querySelector('[data-theme-toggle]');
    var icon = nav.querySelector('[data-theme-toggle-icon]');
    var defaultTheme = nav.getAttribute('data-default-theme') || 'light';

    var THEME_CYCLE = ['light', 'dark', 'auto'];
    var THEME_ICONS = { light: 'light_mode', dark: 'dark_mode', auto: 'brightness_auto' };
    var THEME_LABELS = { light: 'Light theme', dark: 'Dark theme', auto: 'System preference' };

    function applyTheme(theme) {
      if (theme === 'dark') document.documentElement.classList.add('dark');
      else if (theme === 'light') document.documentElement.classList.remove('dark');
      else {
        if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) document.documentElement.classList.add('dark');
        else document.documentElement.classList.remove('dark');
      }
    }

    function syncControls(theme) {
      if (icon) icon.textContent = THEME_ICONS[theme] || THEME_ICONS.light;
      if (toggle) toggle.setAttribute('aria-label', 'Switch color theme (currently ' + (THEME_LABELS[theme] || theme) + ')');
    }

    var currentTheme = localStorage.getItem('color-theme') || defaultTheme;
    if (THEME_CYCLE.indexOf(currentTheme) === -1) currentTheme = 'light';
    applyTheme(currentTheme);
    syncControls(currentTheme);

    if (toggle && icon) {
      toggle.addEventListener('click', function () {
        var nextIndex = (THEME_CYCLE.indexOf(currentTheme) + 1) % THEME_CYCLE.length;
        currentTheme = THEME_CYCLE[nextIndex];
        applyTheme(currentTheme);
        localStorage.setItem('color-theme', currentTheme);
        syncControls(currentTheme);
      });
    }

    if (window.matchMedia) {
      var mediaQuery = window.matchMedia('(prefers-color-scheme: dark)');
      function handleSystemThemeChange() { if (currentTheme === 'auto') applyTheme('auto'); }
      if (mediaQuery.addEventListener) mediaQuery.addEventListener('change', handleSystemThemeChange); else mediaQuery.addListener(handleSystemThemeChange);
    }

    if (typeof window.initFlowbite === 'function') window.initFlowbite();
    nav.dataset.uiKitReady = 'true';
  });
  })();
</script>