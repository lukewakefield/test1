---
metadata:
  name: StudioKit
---
/* studio ui kit */
/* ==========================================================================
   ROUNDED OVERRIDES
   ========================================================================== */

@layer utilities {
  .container {
    @apply mx-auto max-w-[96rem] px-8 py-20 md:px-12 md:py-24 lg:px-16;
  }
  .card {
    @apply rounded-2xl;
  }
}

/* ==========================================================================
   BASE STYLES
   ========================================================================== */

@layer base {

  /* ==========================================================================
     BODY
     ========================================================================== */

  body {
    @apply bg-base-100 dark:bg-base-950 text-[var(--color-neutral-600)] dark:text-[var(--color-neutral-300)] antialiased;
  }

section {
  @apply border border-base-400/40 bg-base-100 dark:bg-base-950 w-full mx-auto min-[2560px]:max-w-[130rem];
}

  /* ==========================================================================
     HEADINGS
     ========================================================================== */

  h1,
  h2,
  h3,
  h4,
  h5,
  h6 {
    @apply font-heading text-[var(--color-neutral-950)] dark:text-[var(--color-neutral-50)];
  }

  /* ==========================================================================
     H1
     Hero / Landing Headline
     ========================================================================== */

  h1 {
    @apply text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-semibold tracking-[-0.04em] leading-[1.05] mb-6;
  }

  /* ==========================================================================
     H2
     Section Headline
     ========================================================================== */

  h2 {
    @apply text-3xl sm:text-4xl md:text-5xl font-semibold tracking-[-0.03em] leading-[1.1] mb-5;
  }

  /* ==========================================================================
     H3
     Feature / Card Headline
     ========================================================================== */

  h3 {
    @apply text-2xl sm:text-3xl font-semibold tracking-[-0.02em] leading-[1.2] mb-4;
  }

  /* ==========================================================================
     H4
     Subsection Heading
     ========================================================================== */

  h4 {
    @apply text-lg
		sm:text-xl
		font-medium
		tracking-[-0.03em]
		leading-snug
		mb-3;
  }

  /* ==========================================================================
     H5
     UI Heading / Label Heading
     ========================================================================== */

  h5 {
    @apply text-base
		sm:text-lg
		font-medium
		tracking-tight
		leading-normal
		mb-2;
  }

  /* ==========================================================================
     H6
     Eyebrow / Meta Heading
     ========================================================================== */

  h6 {
    @apply text-xs
		sm:text-sm
		uppercase
		font-semibold
		tracking-[0.12em]
		text-[var(--color-neutral-500)]
		dark:text-[var(--color-neutral-400)]
		leading-normal
		mb-2;
  }

  /* ==========================================================================
     TEXT
     ========================================================================== */

  p {
    @apply text-[var(--color-neutral-600)]
      dark:text-[var(--color-neutral-300)]
      text-base
      md:text-lg
      mb-4
      leading-relaxed
      font-normal;
  }

  strong {
    @apply text-[var(--color-neutral-950)] dark:text-[var(--color-neutral-50)] font-semibold;
  }

  em {
    @apply italic;
  }

  small {
    @apply text-[var(--color-neutral-500)]
      dark:text-[var(--color-neutral-400)]
      text-xs;
  }

  /* ==========================================================================
     LISTS
     ========================================================================== */

  ul,
  ol {
    @apply pl-5
      text-[var(--color-neutral-600)]
      dark:text-[var(--color-neutral-300)]
      text-base;
  }

  li {
    @apply mb-1.5;
  }

  /* ==========================================================================
     IMAGES
     ========================================================================== */

  img {
    @apply max-w-full
      h-auto
      rounded-xl;
  }

  /* ==========================================================================
     BUTTONS & LINKS
     ========================================================================== */

  .button,
  button {
    @apply inline-flex
      items-center
      justify-center
      gap-2
      bg-[var(--color-primary-500)]
      text-[var(--color-base-50)]
      border
      border-transparent
      px-6
      py-3.5
      rounded-xl
      text-sm
      font-medium
      shadow-sm
      transition-all
      duration-150;
  }

  .button:hover,
  button:hover {
    @apply bg-[var(--color-primary-700)] shadow-md;
  }

  .button:active,
  button:active {
    @apply opacity-90 shadow-sm;
  }

  .button-secondary {
    @apply inline-flex
      items-center
      justify-center
      gap-2
      !bg-transparent
      text-[var(--color-neutral-700)]
      dark:text-[var(--color-neutral-200)]
      border
      border-[var(--color-neutral-300)]
      dark:border-[var(--color-neutral-700)]
      px-6
      py-3.5
      rounded-xl
      text-sm
      font-medium
      transition-all
      duration-150;
  }

  .button-secondary:hover {
    @apply !bg-[var(--color-base-200)] dark:!bg-[var(--color-base-900)] border-[var(--color-neutral-400)] dark:border-[var(--color-neutral-600)];
  }

  .button-secondary:active {
    @apply opacity-90;
  }

  .card {
  }

  /* ==========================================================================
     FORMS
     ========================================================================== */

  label {
    @apply block
      text-xs
      font-medium
      text-[var(--color-neutral-600)]
      dark:text-[var(--color-neutral-300)]
      mb-1.5;
  }

  input,
  textarea,
  select {
    @apply w-full
      bg-base-100
      dark:bg-base-900
      border
      border-[var(--color-neutral-300)]
      dark:border-[var(--color-neutral-700)]
      text-[var(--color-neutral-950)]
      dark:text-[var(--color-neutral-50)]
      px-4
      py-3
      rounded-xl
      text-sm
      outline-none
      transition-all;
  }

  input::placeholder,
  textarea::placeholder {
    @apply text-[var(--color-neutral-500)];
  }

  input:focus,
  textarea:focus,
  select:focus {
    @apply border-[var(--color-primary-500)] ring-2 ring-[var(--color-primary-500)]/20;
  }

  /* ==========================================================================
     CODE
     ========================================================================== */

  code {
    @apply bg-base-200
      dark:bg-base-900
      text-[var(--color-primary-500)]
      px-1.5
      py-0.5
      rounded-md
      text-sm;
  }

  pre {
    @apply bg-base-200
      dark:bg-base-900
      text-[var(--color-neutral-600)]
      dark:text-[var(--color-neutral-300)]
      p-4
      rounded-xl
      overflow-x-auto
      text-sm;
  }

  /* ==========================================================================
     TABLES
     ========================================================================== */

  table {
    @apply w-full
      border-collapse
      text-[var(--color-neutral-600)]
      dark:text-[var(--color-neutral-300)]
      text-sm;
  }

  th {
    @apply text-left
      text-[var(--color-neutral-950)]
      dark:text-[var(--color-neutral-50)]
      border-b
      border-[var(--color-neutral-200)]
      dark:border-[var(--color-neutral-800)]
      py-3
      font-medium;
  }

  td {
    @apply border-b
      border-[var(--color-neutral-200)]
      dark:border-[var(--color-neutral-800)]
      py-3;
  }

  tr {
    @apply transition-colors duration-150;
  }

  tbody tr:hover {
    @apply bg-base-200/50 dark:bg-base-900/50;
  }

  /* ==========================================================================
     FOCUS STATES
     ========================================================================== */

  :focus-visible {
    @apply outline-none
      ring-2
      ring-[var(--color-primary-500)]/40;
  }
}

  /* ==========================================================================
     RICH CONTENT
     ========================================================================== */

  .format {
    @apply text-[var(--color-neutral-700)]
      dark:text-[var(--color-neutral-300)]
      font-light
      leading-relaxed;
  }

  .format h1 {
    @apply text-4xl
      sm:text-5xl
      font-semibold
      tracking-[-0.03em]
      leading-tight
      mb-6
      text-[var(--color-neutral-950)]
      dark:text-[var(--color-neutral-50)];
  }

  .format h2 {
    @apply text-3xl
      sm:text-4xl
      font-semibold
      tracking-[-0.02em]
      leading-tight
      mt-10
      mb-5
      text-[var(--color-neutral-950)]
      dark:text-[var(--color-neutral-50)];
  }

  .format h3 {
    @apply text-2xl
      sm:text-3xl
      font-semibold
      tracking-[-0.01em]
      leading-tight
      mt-8
      mb-4
      text-[var(--color-neutral-950)]
      dark:text-[var(--color-neutral-50)];
  }

  .format h4 {
    @apply text-xl
      sm:text-2xl
      font-medium
      mt-7
      mb-3
      text-[var(--color-neutral-950)]
      dark:text-[var(--color-neutral-50)];
  }

  .format h5 {
    @apply text-lg
      sm:text-xl
      font-medium
      mt-6
      mb-2
      text-[var(--color-neutral-950)]
      dark:text-[var(--color-neutral-50)];
  }

  .format h6 {
    @apply text-sm
      uppercase
      font-semibold
      tracking-[0.1em]
      mt-6
      mb-2
      text-[var(--color-neutral-500)]
      dark:text-[var(--color-neutral-400)];
  }

  .format p {
    @apply text-base
      md:text-lg
      leading-7
      font-light
      mb-5
      text-[var(--color-neutral-700)]
      dark:text-[var(--color-neutral-300)];
  }

  .format strong {
    @apply font-semibold
      text-[var(--color-neutral-950)]
      dark:text-[var(--color-neutral-50)];
  }

  .format em {
    @apply italic;
  }

  .format a {
    @apply text-[var(--color-primary-500)]
      underline
      underline-offset-4
      transition-colors;
  }

  .format a:hover {
    @apply text-[var(--color-primary-700)];
  }

  .format ul,
  .format ol {
    @apply pl-6
      mb-6
      text-base
      md:text-lg
      leading-7
      text-[var(--color-neutral-700)]
      dark:text-[var(--color-neutral-300)];
  }

  .format ul {
    @apply list-disc;
  }

  .format ol {
    @apply list-decimal;
  }

  .format li {
    @apply mb-2
      pl-1;
  }

  .format li > ul,
  .format li > ol {
    @apply mt-2
      mb-0;
  }

  .format blockquote {
    @apply border-l-4
      border-[var(--color-primary-500)]
      pl-5
      my-8
      italic
      text-lg
      md:text-xl
      leading-8
      text-[var(--color-neutral-600)]
      dark:text-[var(--color-neutral-300)];
  }

  .format hr {
    @apply my-10
      border-0
      border-t
      border-[var(--color-neutral-200)]
      dark:border-[var(--color-neutral-800)];
  }

  .format img {
    @apply max-w-full
      h-auto
      my-8;
  }

  .format figure {
    @apply my-8;
  }

  .format figcaption {
    @apply mt-3
      text-sm
      text-[var(--color-neutral-500)]
      dark:text-[var(--color-neutral-400)];
  }

  .format table {
    @apply w-full
      my-8
      border-collapse
      text-sm
      md:text-base;
  }

  .format th {
    @apply text-left
      font-medium
      px-4
      py-3
      bg-base-200
      dark:bg-base-900
      text-[var(--color-neutral-950)]
      dark:text-[var(--color-neutral-50)]
      border-b
      border-[var(--color-neutral-200)]
      dark:border-[var(--color-neutral-800)];
  }

  .format td {
    @apply px-4
      py-3
      border-b
      border-[var(--color-neutral-200)]
      dark:border-[var(--color-neutral-800)]
      text-[var(--color-neutral-700)]
      dark:text-[var(--color-neutral-300)];
  }

  .format code {
    @apply bg-base-200
      dark:bg-base-900
      text-[var(--color-primary-500)]
      px-1.5
      py-0.5
      rounded-md
      text-sm;
  }

  .format pre {
    @apply bg-base-200
      dark:bg-base-900
      text-[var(--color-neutral-600)]
      dark:text-[var(--color-neutral-300)]
      p-5
      my-8
      rounded-xl
      overflow-x-auto
      text-sm
      leading-6;
  }

  .format pre code {
    @apply bg-transparent
      p-0
      text-inherit;
  }



@theme {

  --radius-xs: 0.2rem;
  --radius-sm: 0.35rem;
  --radius-md: 0.6rem;
  --radius-lg: 0.9rem;
  --radius-xl: 1.3rem;
  --radius-2xl: 1.8rem;
  --radius-3xl: 2.4rem;
  --radius-4xl: 3rem;
  --radius-5xl: 3.8rem;
  --radius-6xl: 4.5rem;
  --radius-full: 9999px;

  
}



@layer utilities {

  
}