/* Quiet dark studio. Soft radii, almost no shadow, one orange accent.
   The server wraps this file in @theme. */

--radius-xs: 0.375rem;
--radius-sm: 0.5rem;
--radius-md: 0.75rem;
--radius-lg: 1rem;
--radius-xl: 1.25rem;
--radius-2xl: 1.5rem;
--radius-3xl: 1.75rem;
--radius-4xl: 2rem;
--radius-full: 9999px;

--shadow-2xs: 0 0 0 1px rgba(255, 255, 255, 0.06);
--shadow-xs: 0 1px 2px rgba(0, 0, 0, 0.24);
--shadow-sm: 0 2px 8px rgba(0, 0, 0, 0.28);
--shadow-md: 0 8px 24px rgba(0, 0, 0, 0.32);
--shadow-lg: 0 16px 40px rgba(0, 0, 0, 0.36);
--shadow-xl: 0 24px 48px rgba(0, 0, 0, 0.4);
--shadow-2xl: 0 32px 64px rgba(0, 0, 0, 0.45);

/* Emphasis. Sections should use <mark> when a word needs the orange accent. */
--mark-color: var(--color-primary-500);

--color-primary-50-bridge: var(--color-primary-50);
