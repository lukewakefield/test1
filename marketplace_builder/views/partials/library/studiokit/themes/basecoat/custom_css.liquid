/* Basecoat theme. Component classes (.btn, .card, .sidebar, .input) come from
   the Basecoat stylesheet loaded by the Basecoat template. These rules cover
   the StudioKit required elements so other sections still read as Basecoat
   when this theme is active. .btn stays owned by Basecoat (higher specificity). */

@layer base {
  html {
    background: var(--color-base-50);
    color: var(--color-neutral-900);
    font-family: var(--font-body), Geist, ui-sans-serif, system-ui, sans-serif;
  }

  body,
  .body {
    background: var(--color-base-50);
    color: var(--color-neutral-900);
    font-family: var(--font-body), Geist, ui-sans-serif, system-ui, sans-serif;
    font-size: 14px;
    font-weight: 400;
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
  }

  h1, .h1, h2, .h2, h3, .h3, h4, .h4, h5, .h5, h6, .h6 {
    font-family: var(--font-heading), Geist, ui-sans-serif, system-ui, sans-serif;
    font-weight: 600;
    color: var(--color-neutral-900);
    letter-spacing: -0.025em;
  }

  h1, .h1 {
    font-size: 1.875rem;
    line-height: 1.15;
    margin-bottom: 0.75rem;
  }

  h2, .h2 {
    font-size: 1.25rem;
    line-height: 1.3;
    margin-bottom: 0.5rem;
  }

  h3, .h3 {
    font-size: 1rem;
    line-height: 1.4;
    margin-bottom: 0.25rem;
  }

  h4, .h4 {
    font-size: 0.875rem;
    line-height: 1.4;
    margin-bottom: 0.25rem;
  }

  h5, .h5 {
    font-size: 0.875rem;
    line-height: 1.4;
    margin-bottom: 0.25rem;
  }

  h6, .h6 {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-neutral-500);
    margin-bottom: 0.25rem;
  }

  p, .p {
    color: var(--color-neutral-600);
    font-size: 0.875rem;
    line-height: 1.6;
    max-width: 42rem;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  a:hover {
    color: inherit;
  }

  button,
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    height: 32px;
    padding: 0 12px;
    border-radius: 8px;
    border: 1px solid transparent;
    background: var(--color-primary-500);
    color: #ffffff;
    font-family: inherit;
    font-size: 14px;
    font-weight: 500;
    line-height: 1;
    cursor: pointer;
  }

  button:hover,
  .button:hover {
    background: var(--color-primary-600);
    color: #ffffff;
  }

  button:focus-visible,
  .button:focus-visible {
    outline: 2px solid var(--color-neutral-900);
    outline-offset: 2px;
  }

  button:disabled,
  .button:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-variant-numeric: tabular-nums;
    font-size: 14px;
  }

  th, td {
    padding: 0.5rem 0.75rem;
    text-align: start;
    border-bottom: 1px solid var(--color-neutral-200);
    color: var(--color-neutral-900);
  }

  th {
    font-weight: 500;
    color: var(--color-neutral-500);
  }

  blockquote {
    margin: 0;
    padding-inline-start: 1rem;
    border-inline-start: 2px solid var(--color-neutral-200);
    color: var(--color-neutral-600);
  }

  ul {
    list-style: disc;
    padding-inline-start: 1.25rem;
  }

  ol {
    list-style: decimal;
    padding-inline-start: 1.25rem;
  }

  ul ul,
  ol ul {
    list-style-type: circle;
  }

  li, dt, dd {
    color: var(--color-neutral-700);
  }

  dl {
    display: grid;
    gap: 0.25rem;
  }

  code {
    font-family: var(--font-code), "Geist Mono", ui-monospace, monospace;
    font-size: 0.8125rem;
    background: var(--color-neutral-100);
    border-radius: 4px;
    padding: 0.1em 0.35em;
  }

  img {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
  }

  input:not([type="checkbox"]):not([type="radio"]):not([type="range"]):not([type="file"]):not([type="hidden"]):not([type="submit"]):not([type="button"]):not([type="reset"]),
  textarea,
  select {
    height: 32px;
    width: 100%;
    padding: 0 12px;
    border-radius: 8px;
    border: 1px solid var(--color-neutral-200);
    background: var(--color-base-50);
    color: var(--color-neutral-900);
    font-family: inherit;
    font-size: 14px;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
  }

  textarea {
    height: auto;
    min-height: 80px;
    padding: 8px 12px;
    resize: vertical;
  }

  input:focus,
  textarea:focus,
  select:focus {
    outline: 2px solid var(--color-neutral-900);
    outline-offset: 1px;
  }

  label {
    font-size: 14px;
    font-weight: 500;
    color: var(--color-neutral-900);
  }

  figure {
    margin: 0;
  }

  figcaption {
    margin-top: 0.5rem;
    font-size: 12px;
    color: var(--color-neutral-500);
  }

  cite, q {
    font-style: normal;
  }

  mark {
    background: var(--color-neutral-100);
    color: var(--color-neutral-900);
    border-radius: 4px;
    padding: 0 0.2em;
  }

  small {
    font-size: 12px;
    color: var(--color-neutral-500);
  }

  summary {
    cursor: pointer;
    font-weight: 500;
  }

  fieldset {
    border: 0;
    padding: 0;
    margin: 0;
  }

  legend {
    font-size: 14px;
    font-weight: 500;
  }

  section {
    width: 100%;
    background: var(--color-base-50);
  }
}

@layer components {
  .container {
    width: 100%;
    max-width: 72rem;
    margin-inline: auto;
    padding-inline: 1.5rem;
  }

  .eyebrow_text {
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-neutral-500);
  }

  .button-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 32px;
    padding: 0 12px;
    border-radius: 8px;
    border: 1px solid var(--color-neutral-200);
    background: var(--color-base-50);
    color: var(--color-neutral-900);
    font-size: 14px;
    font-weight: 500;
  }

  .button-secondary:hover {
    background: var(--color-neutral-100);
  }

  .card {
    background: var(--color-base-50);
    color: var(--color-neutral-900);
    border: 1px solid var(--color-neutral-200);
    border-radius: 12px;
    box-shadow: var(--shadow-sm);
  }

  .bc-sidebar {
    position: static;
    width: 100%;
    height: auto;
  }

  .bc-main {
    margin-inline-start: 0;
  }

  @media (min-width: 48rem) {
    .bc-sidebar {
      position: fixed;
      inset-block: 0;
      inset-inline-start: 0;
      z-index: 30;
      width: 16rem;
      height: 100svh;
      overflow: auto;
      border-inline-end: 1px solid var(--color-neutral-200);
      background: var(--color-base-100);
    }

    .bc-main {
      margin-inline-start: 16rem;
    }
  }
}
