---
metadata:
  name: Mono
---
/* studio ui kit */
/* ==========================================================================
   ROUNDED OVERRIDES
   ========================================================================== */

@layer utilities {
  .container {
    @apply mx-auto max-w-[96rem] px-8 py-20 md:px-12 md:py-24 lg:px-16 
  }
  .card {
    @apply rounded-none ;
  }
}

/* ==========================================================================
   BASE STYLES
   ========================================================================== */

@layer base {

  /* ==========================================================================
     BODY
     ========================================================================== */

  body {
    @apply bg-base-100 dark:bg-base-900 text-[var(--color-neutral-500)] dark:text-[var(--color-neutral-50)] antialiased;
  }

section {
  @apply bg-base-100 dark:bg-base-950 w-full mx-auto min-[2560px]:max-w-[130rem];
}

  /* ==========================================================================
     HEADINGS
     ========================================================================== */

  h1,
  h2,
  h3,
  h4,
  h5,
  h6 {
    @apply font-heading text-[var(--color-neutral-950)] dark:text-[var(--color-neutral-50)];
  }

  /* ==========================================================================
     H1
     Hero / Landing Headline
     ========================================================================== */

  h1 {
    @apply text-5xl sm:text-5xl md:text-6xl lg:text-7xl font-medium tracking-[-0.06em] leading-[0.95] mb-8;

    word-spacing: 0.08em;
  }

  /* ==========================================================================
     H2
     Section Headline
     ========================================================================== */

  h2 {
    @apply text-3xl sm:text-4xl md:text-5xl font-medium tracking-[-0.05em] leading-[1] mb-6;

    word-spacing: 0.05em;
  }

  /* ==========================================================================
     H3
     Feature / Card Headline
     ========================================================================== */

  h3 {
    @apply text-2xl sm:text-3xl font-medium tracking-[-0.04em] leading-[1.1] mb-4;
  }

  /* ==========================================================================
     H4
     Subsection Heading
     ========================================================================== */

  h4 {
    @apply text-lg
		sm:text-xl
		font-medium
		tracking-[-0.03em]
		leading-snug
		mb-3;
  }

  /* ==========================================================================
     H5
     UI Heading / Label Heading
     ========================================================================== */

  h5 {
    @apply text-base
		sm:text-lg
		font-medium
		tracking-tight
		leading-normal
		mb-2;
  }

  /* ==========================================================================
     H6
     Eyebrow / Meta Heading
     ========================================================================== */

  h6 {
    @apply text-xs
		sm:text-sm
		uppercase
		font-semibold
		tracking-[0.12em]
		text-[var(--color-neutral-500)]
		dark:text-[var(--color-neutral-400)]
		leading-normal
		mb-2;
  }

  /* ==========================================================================
     TEXT
     ========================================================================== */

  p {
    @apply text-[var(--color-neutral-700)]
		dark:text-[var(--color-neutral-50)]
		md:text-lg
		mb-0
		leading-[28px]
		font-light;
  }

  strong {
    @apply text-[var(--color-neutral-950)] font-medium;
  }

  em {
    @apply italic;
  }

  small {
    @apply text-[var(--color-neutral-500)]
 dark:text-[var(--color-neutral-50)]
 text-xs;
  }

  /* ==========================================================================
     LISTS
     ========================================================================== */

  ul,
  ol {
    @apply pl-5
 text-[var(--color-neutral-950)]
 dark:text-[var(--color-neutral-50)]
 text-sm;
  }

  li {
    @apply mb-1.5;
  }

  /* ==========================================================================
     IMAGES
     ========================================================================== */

  img {
    @apply max-w-full
 h-auto
 rounded-[0rem];
  }

  /* ==========================================================================
     BUTTONS & LINKS
     ========================================================================== */

  .button,
  button {
    @apply inline-flex
 items-center
 justify-center
 bg-[var(--color-primary-900)]
 text-[var(--color-base-50)]
 border
 border-[var(--color-primary-strong)]
 px-8
 py-5
 rounded-[0rem]
 text-sm
 font-medium
 transition-colors
 duration-150;
  }

  .button:hover,
  button:hover {
    @apply bg-[var(--color-primary-700)];
  }

  .button:active,
  button:active {
    @apply opacity-90;
  }

  .button-secondary {
    @apply inline-flex
 items-center
 justify-center
 gap-2
 !bg-transparent
 text-[var(--color-neutral-600)]
 dark:text-[var(--color-neutral-50)]
 border
 border-[var(--color-neutral-400)]
 px-8
 py-5
 rounded-[0rem]
 text-sm
 font-medium
 transition-colors
 duration-150;
  }

  .button-secondary:hover {
    @apply !bg-[var(--color-base-200)] dark:!bg-[var(--color-base-900)];
  }

  .button-secondary:active {
    @apply opacity-90;
  }

  .card {
  }

  /* ==========================================================================
     FORMS
     ========================================================================== */

  label {
    @apply block
 text-xs
 font-medium
 text-[var(--color-neutral-500)]
 dark:text-[var(--color-neutral-50)]
 mb-1.5;
  }

  input,
  textarea,
  select {
    @apply w-full
 bg-[var(--color-neutral-secondary)]
 border
 border-[var(--color-neutral-800)]
 text-[var(--color-neutral-950)]
 px-3
 py-4
 rounded-[0rem]
 text-sm
 outline-none
 transition-all;
  }

  input::placeholder,
  textarea::placeholder {
    @apply text-[var(--color-neutral-500)];
  }

  input:focus,
  textarea:focus,
  select:focus {
    @apply border-[var(--color-primary)];
  }

  /* ==========================================================================
     CODE
     ========================================================================== */

  code {
    @apply bg-[var(--color-neutral-secondary)]
 text-[var(--color-primary)]
 px-1.5
 py-0.5
 rounded-[0rem]
 text-sm;
  }

  pre {
    @apply bg-[var(--color-neutral-secondary)]
 text-[var(--color-neutral-500)]
 p-4
 rounded-[0rem]
 overflow-x-auto
 text-sm;
  }

  /* ==========================================================================
     TABLES
     ========================================================================== */

  table {
    @apply w-full
 border-collapse
 text-[var(--color-neutral-500)]
 text-sm;
  }

  th {
    @apply text-left
 text-[var(--color-neutral-950)]
 border-b
 border-[var(--color-neutral-800)]
 py-2
 font-medium;
  }

  td {
    @apply border-b
 border-[var(--color-neutral-800)]
 py-2;
  }

  /* ==========================================================================
     FOCUS STATES
     ========================================================================== */

  :focus-visible {
    @apply outline-none
 ring-2
 ring-[var(--color-primary)]/40;
  }
}

/* ==========================================================================
     RICH CONTENT
     ========================================================================== */

  .format {
    @apply text-[var(--color-neutral-700)]
      dark:text-[var(--color-neutral-300)]
      font-light
      leading-relaxed;
  }

  .format h1 {
    @apply text-4xl
      sm:text-5xl
      font-medium
      tracking-[-0.04em]
      leading-tight
      mb-6
      text-[var(--color-neutral-950)]
      dark:text-[var(--color-neutral-50)];
  }

  .format h2 {
    @apply text-3xl
      sm:text-4xl
      font-medium
      tracking-[-0.03em]
      leading-tight
      mt-10
      mb-5
      text-[var(--color-neutral-950)]
      dark:text-[var(--color-neutral-50)];
  }

  .format h3 {
    @apply text-2xl
      sm:text-3xl
      font-medium
      tracking-[-0.02em]
      leading-tight
      mt-8
      mb-4
      text-[var(--color-neutral-950)]
      dark:text-[var(--color-neutral-50)];
  }

  .format h4 {
    @apply text-xl
      sm:text-2xl
      font-medium
      mt-7
      mb-3
      text-[var(--color-neutral-950)]
      dark:text-[var(--color-neutral-50)];
  }

  .format h5 {
    @apply text-lg
      sm:text-xl
      font-medium
      mt-6
      mb-2
      text-[var(--color-neutral-950)]
      dark:text-[var(--color-neutral-50)];
  }

  .format h6 {
    @apply text-sm
      uppercase
      font-semibold
      tracking-[0.1em]
      mt-6
      mb-2
      text-[var(--color-neutral-500)]
      dark:text-[var(--color-neutral-400)];
  }

  .format p {
    @apply text-base
      md:text-lg
      leading-7
      font-light
      mb-5
      text-[var(--color-neutral-700)]
      dark:text-[var(--color-neutral-300)];
  }

  .format strong {
    @apply font-semibold
      text-[var(--color-neutral-950)]
      dark:text-[var(--color-neutral-50)];
  }

  .format em {
    @apply italic;
  }

  .format a {
    @apply text-[var(--color-primary-500)]
      underline
      underline-offset-4
      transition-colors;
  }

  .format a:hover {
    @apply text-[var(--color-primary-700)];
  }

  .format ul,
  .format ol {
    @apply pl-6
      mb-6
      text-base
      md:text-lg
      leading-7
      text-[var(--color-neutral-700)]
      dark:text-[var(--color-neutral-300)];
  }

  .format ul {
    @apply list-disc;
  }

  .format ol {
    @apply list-decimal;
  }

  .format li {
    @apply mb-2
      pl-1;
  }

  .format li > ul,
  .format li > ol {
    @apply mt-2
      mb-0;
  }

  .format blockquote {
    @apply border-l-4
      border-[var(--color-primary-500)]
      pl-5
      my-8
      italic
      text-lg
      md:text-xl
      leading-8
      text-[var(--color-neutral-600)]
      dark:text-[var(--color-neutral-300)];
  }

  .format hr {
    @apply my-10
      border-0
      border-t
      border-[var(--color-neutral-200)]
      dark:border-[var(--color-neutral-800)];
  }

  .format img {
    @apply max-w-full
      h-auto
      my-8;
  }

  .format figure {
    @apply my-8;
  }

  .format figcaption {
    @apply mt-3
      text-sm
      text-[var(--color-neutral-500)]
      dark:text-[var(--color-neutral-400)];
  }

  .format table {
    @apply w-full
      my-8
      border-collapse
      text-sm
      md:text-base;
  }

  .format th {
    @apply text-left
      font-medium
      px-4
      py-3
      bg-[var(--color-neutral-secondary)]
      text-[var(--color-neutral-950)]
      dark:text-[var(--color-neutral-50)]
      border-b
      border-[var(--color-neutral-800)];
  }

  .format td {
    @apply px-4
      py-3
      border-b
      border-[var(--color-neutral-800)]
      text-[var(--color-neutral-700)]
      dark:text-[var(--color-neutral-300)];
  }

  .format code {
    @apply bg-[var(--color-neutral-secondary)]
      text-[var(--color-primary-500)]
      px-1.5
      py-0.5
      rounded-none
      text-sm;
  }

  .format pre {
    @apply bg-[var(--color-neutral-secondary)]
      text-[var(--color-neutral-500)]
      p-5
      my-8
      rounded-none
      overflow-x-auto
      text-sm
      leading-6;
  }

  .format pre code {
    @apply bg-transparent
      p-0
      text-inherit;
  }


/* ==========================================================================
   THEME BRIDGES
   Bridge current theme colors so variants can remap them safely
   ========================================================================== */

@theme {

  --radius-xs: 0rem;
  --radius-sm: 0rem;
  --radius-md: 0rem;
  --radius-lg: 0.9rem;
  --radius-xl: 0rem;
  --radius-2xl: 0rem;
  --radius-3xl: 2.4rem;
  --radius-4xl: 3rem;
  --radius-5xl: 3.8rem;
  --radius-6xl: 4.5rem;
  --radius-full: 9999px;

  
}



@layer utilities {

  
}