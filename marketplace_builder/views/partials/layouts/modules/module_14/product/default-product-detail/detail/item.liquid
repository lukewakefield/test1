    class="fixed top-25 left-0 right-0 z-50 h-12 bg-white dark:bg-gray-900 border-b border-gray-200 dark:border-gray-700 hidden"
>
    <div class="h-full max-w-[100rem] mx-auto px-4 flex items-center justify-between gap-4">

        <div class="flex items-center gap-3 min-w-0">
            <img
                src="{{this['Image'] | asset_url}}"
                alt="{{this.name}}"
                class="w-8 h-8 object-cover rounded shrink-0"
            >

            <div class="min-w-0 flex items-center gap-3">
                <span class="text-sm font-medium text-gray-900 dark:text-white truncate">
                    {{this['name']}}
                </span>

                <span
                    class="text-sm font-bold text-gray-900 dark:text-white whitespace-nowrap"
                    data-sticky-price
                >
                    {{this.price.currency_symbol}}{{this.price.price_charge | divided_by: 100.0 | format_number: precision: 2}}
                </span>
            </div>
        </div>

        <div class="flex items-center gap-2 shrink-0">
            <a
                href="#"
                class="button-secondary text-sm px-4 py-1.5"
                onclick="window.scrollTo({ top: 0, behavior: 'smooth' }); return false;"
            >
                View Details
            </a>
        </div>

    </div>
</div>

<script>
(function () {
    function updateStickyPrice() {
        var mainPrice = document.querySelector('[data-price-control]');
        var stickyPrice = document.querySelector('[data-sticky-price]');

        if (!mainPrice || !stickyPrice) return;

        var currency = mainPrice.getAttribute('data-currency-control') || '';
        var price = parseFloat(mainPrice.getAttribute('data-price-control'));

        if (!isNaN(price)) {
            stickyPrice.textContent = currency + (price / 100).toFixed(2);
        }
    }

    function updateStickyVisibility() {
        var strip = document.querySelector('[data-sticky-product-strip]');

        if (!strip) return;

        if (window.scrollY >= window.innerHeight) {
            strip.classList.remove('hidden');
        } else {
            strip.classList.add('hidden');
        }
    }

    function initStickyProductStrip() {
        updateStickyPrice();
        updateStickyVisibility();

        window.addEventListener('scroll', updateStickyVisibility, {
            passive: true
        });

        var originalUpdatePrice = window.s_e_update_price;

        if (typeof originalUpdatePrice === 'function') {
            window.s_e_update_price = function () {
                originalUpdatePrice.apply(this, arguments);
                updateStickyPrice();
            };
        }
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initStickyProductStrip);
    } else {
        initStickyProductStrip();
    }
})();
</script>
