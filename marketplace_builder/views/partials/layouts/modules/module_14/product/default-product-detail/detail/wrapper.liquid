---
metadata:
  studio_theme: studiokit
  studio_library: studiokit
  studio_dynamic/type: detail
  studio_dynamic/files:
  - views/partials/layouts/modules/module_14/product/default-product-detail/detail/wrapper.liquid
  - views/partials/layouts/modules/module_14/product/default-product-detail/detail/item.liquid
  - views/partials/layouts/modules/module_14/components/add_to_cart_button/default-product-detail.liquid
  - views/partials/layouts/modules/module_14/product_attributes/default-product-detail.liquid
  - views/partials/layouts/modules/module_14/product/default-product-detail/structured_data.liquid
  studio_dynamic/theme: studiokit
  studio_dynamic/layout: default-product-detail
  studio_dynamic/theme_id: theme_01
  studio_dynamic/module_id: module_14
  studio_dynamic/layout_name: Default Product Detail
  studio_dynamic/live_updates: 'false'
  studio_dynamic/ui_framework: tailwind
  studio_dynamic/original_name: Default Product Detail
  studio_dynamic/sub_module_id: '2'
  studio_dynamic/make_global_form: false
---
{% comment %} ---Settings--- {% endcomment %}
{% comment %} ------ Cart URL ------ {% endcomment %}
{% assign cart_url = '/cart' %}
{% comment %} ------Display Only Price Settings-------
Siteglide's Products contain a Display Only Price which can be used flexibily. If your Products use the Display only Price to show original price before a global discount, you could set "show_display_price_crossed_out" to true. {% endcomment %}
{% assign show_display_price_crossed_out = true %}

{% comment %}----- Optional custom fields for product structured data -----{% endcomment %}
{% comment %} Pass in the ID of each custom field which contains the dynamic data for this {% endcomment %}
{% comment %} e.g. "module_field_custom_14/product_1" ------{% endcomment %}
{% assign cf_product_brand = null %}

{% comment %} ---End Settings--- {% endcomment %}
{% capture sitebuilder_uniq_component_id %}sitegurus_component_{% increment sitegurus_gen_uniq_component_id %}{% endcapture %}
<section class=" ">
	<div class="container max-w-screen-xl px-4 mx-auto 2xl:px-0">

    {%- comment -%}
      Resolve product by slug and then fetch the full computed product record
      through the `module` include scoped to that id. This avoids a known
      platform issue where passing `slug` to the core module include can
      return the first product rather than the matched one.
    {%- endcomment -%}

    {%- assign path_segments = context.location.pathname | split: '/' -%}
    {%- assign _slug = '' -%}
    {%- for seg in path_segments reversed -%}
      {%- unless seg == blank -%}
        {%- assign _slug = seg -%}
        {%- break -%}
      {%- endunless -%}
    {%- endfor -%}

    {%- if _slug == blank -%}
      {%- response_status 404 -%}
      {%- include '404' -%}
    {%- else -%}

      {% graphql product_query, slug: _slug %}
        query product_by_slug($slug: String!) {
          records(
            per_page: 1
            filter: {
              table: { value: "module_14/product" }
              properties: [{ name: "slug", value: $slug }]
            }
          ) {
            results {
              id
              properties
            }
          }
        }
      {% endgraphql %}

      {%- assign slug_match = product_query.records.results[0] -%}

      {%- if slug_match == blank -%}
        {%- response_status 404 -%}
        {%- include '404' -%}
      {%- else -%}
        {%- include 'module', id: '14/product', item_ids: slug_match.id, collection: 'true', per_page: '1', datasource: 'true', type: 'list' -%}
        {%- assign this = context.exports['module_14/product'].data.result.items[0] -%}

        {%- if this == blank or this.enabled == false -%}
          {%- response_status 404 -%}
          {%- include '404' -%}
        {%- else -%}
          {%- include 'layouts/modules/module_14/product/default-product-detail/detail/item' -%}
        {%- endif -%}
      {%- endif -%}

    {%- endif -%}

	</div>
</section>

