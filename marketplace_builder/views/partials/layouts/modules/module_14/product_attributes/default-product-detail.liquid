---
metadata:
  studio_theme: studiokit
  studio_library: studiokit
  studio_dynamic/type: detail
  studio_dynamic/files:
  - views/partials/layouts/modules/module_14/product/default-product-detail/detail/wrapper.liquid
  - views/partials/layouts/modules/module_14/product/default-product-detail/detail/item.liquid
  - views/partials/layouts/modules/module_14/components/add_to_cart_button/default-product-detail.liquid
  - views/partials/layouts/modules/module_14/product_attributes/default-product-detail.liquid
  - views/partials/layouts/modules/module_14/product/default-product-detail/structured_data.liquid
  studio_dynamic/theme: studiokit
  studio_dynamic/layout: default-product-detail
  studio_dynamic/theme_id: theme_01
  studio_dynamic/module_id: module_14
  studio_dynamic/layout_name: Default Product Detail
  studio_dynamic/live_updates: 'false'
  studio_dynamic/ui_framework: tailwind
  studio_dynamic/original_name: Default Product Detail
  studio_dynamic/sub_module_id: '2'
  studio_dynamic/make_global_form: false
---
<div class="max-w-sm">
  <label class="block mb-2 text-sm font-medium text-gray-900 dark:text-white" for="{{this_attribute.properties.name | slugify}}_base">{{name}}</label>

  <div class="flex flex-wrap gap-2" data-attribute-buttons="{{product_attribute_id}}">
    <label class="button px-3 py-2 text-sm cursor-pointer">
      <input type="radio" class="sr-only" name="{{this_attribute.properties.name | slugify}}" id="{{this_attribute.properties.name | slugify}}_base" data-attribute-control="{{product_attribute_id}}" data-attribute-price-control="0" value="" checked>
      Base
    </label>
    {% for option in product_attribute_options -%}
      <label class="button-secondary px-3 py-2 text-sm cursor-pointer">
        <input type="radio" class="sr-only" name="{{this_attribute.properties.name | slugify}}" data-attribute-control="{{product_attribute_id}}" data-attribute-price-control="{{option.price_raw}}" value="{{option.id}}">
        {{option.name}}{% if option.price != "0.00" %}{% if this.product_attributes.size > 1 %} + {{this.price.currency_symbol}}{{option.price | format_number: precision: 2}}{% else %} {{this.price.currency_symbol}}{{this.price.price_charge | divided_by: 100.0 | plus: option.price | format_number: precision: 2}}{% endif %} {% endif %}
      </label>
    {% endfor -%}
  </div>

  <script>
  (function(){
    var wrap = document.querySelector('[data-attribute-buttons="{{product_attribute_id}}"]');
    if (!wrap) return;
    wrap.addEventListener('change', function(e){
      var input = e.target.closest('input[type="radio"]');
      if (!input) return;
      wrap.querySelectorAll('label').forEach(function(l){ l.classList.remove('button'); l.classList.add('button-secondary'); });
      input.closest('label').classList.remove('button-secondary'); input.closest('label').classList.add('button');
      var optionId = input.value || '';

      var imageArr = Array.from(document.querySelectorAll('[data-sg-attr-image]'));
      var imageEl = imageArr.find(function(i){ return i.dataset.sgAttrImage === optionId; }) || imageArr.find(function(i){ return i.dataset.sgAttrImage === 'undefined'; });
      var topImageEl = document.querySelector('[data-sg-main-image]');
      if (imageEl && topImageEl) {
        var topImageId = topImageEl.dataset.sgAttrImage;
        var topImageSrc = topImageEl.getAttribute('src');
        var thisSrc = imageEl.getAttribute('src');
        imageEl.setAttribute('src', topImageSrc);
        imageEl.setAttribute('data-sg-attr-image', topImageId);
        topImageEl.setAttribute('src', thisSrc);
        topImageEl.setAttribute('data-sg-attr-image', optionId);
      }

      if (typeof s_e_update_price === 'function') s_e_update_price();
    });
  })();
  </script>
</div>
