---
metadata:
  studio_theme: studiokit
  studio_library: studiokit
  studio_dynamic/type: default
  studio_dynamic/files:
  - views/partials/layouts/modules/module_5/log_in/default-login-page.liquid
  studio_dynamic/theme: studiokit
  studio_dynamic/layout: default-login-page
  studio_dynamic/theme_id: theme_01
  studio_dynamic/module_id: module_5
  studio_dynamic/layout_name: Default login page
  studio_dynamic/live_updates: 'false'
  studio_dynamic/ui_framework: tailwind
  studio_dynamic/original_name: Default login page
  studio_dynamic/sub_module_id: '1'
  studio_dynamic/make_global_form: false
---
{% comment %} ---Settings--- {% endcomment %}
{% assign sign_up_url = "/register" %}
{% comment %}
  side_image / side_image_alt — this layout is rendered via a raw
  {% include 'login_form', layout: 'default-login-page' %} (see views/pages/login.liquid),
  not through the Studio page-builder's Section/Form system, so there is no
  Studio "settings" panel for it. Set these the same way `layout`/`redirect`
  are already passed through login_form.liquid, e.g.:
  {% include 'login_form', layout: 'default-login-page', side_image: 'library/path/to/image.jpg', side_image_alt: 'Welcome back' %}
{% endcomment %}
{% comment %}---End Settings--- {% endcomment %}

<section data-motion-group>
  <div class="container">
    <div class="mx-auto py-8 md:py-12 lg:py-16">
      <div class="mx-auto flex max-w-6xl overflow-hidden rounded-2xl border border-base-200 bg-white shadow-sm dark:border-base-700 dark:bg-base-900{% if side_image != blank %} lg:min-h-[680px]{% endif %}">

        {% if side_image != blank %}
          {% capture side_image_attributes %}alt="{{ side_image_alt | default: context.exports.company_information.properties.company_name | default: 'Login' }}" loading="lazy"{% endcapture %}
          <div class="relative hidden overflow-hidden rounded-2xl lg:block lg:w-[46%]">
            {% include 'img'
              , path: side_image
              , layout: 'default/base'
              , classes: 'absolute inset-0 h-full w-full object-cover'
              , attributes: side_image_attributes %}

            <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/10 to-transparent"></div>

            <div class="absolute inset-x-0 bottom-0 p-10 text-white">
              <div class="max-w-sm">
                <span class="mb-4 inline-flex rounded-full border border-white/30 bg-white/10 px-3 py-1 text-xs font-medium backdrop-blur-sm">
                  Welcome back
                </span>

                <h2 class="text-3xl font-semibold tracking-tight text-neutral-100">
                  Welcome back. Sign in to continue.
                </h2>

                <p class="mt-3 text-sm leading-6 text-white/80">
                  Access your account and pick up right where you left off.
                </p>
              </div>
            </div>
          </div>
        {% endif %}

        <div class="flex w-full flex-col justify-center{% if side_image != blank %} lg:w-[54%]{% endif %}">
          <div class="mx-auto w-full max-w-xl px-6 py-8 sm:px-10 md:px-12 md:py-12 lg:px-14 lg:py-14">

            <a
              href="/"
              class="mb-10 inline-flex items-center"
              data-motion-text>
              <img
                class="h-8 w-auto dark:hidden"
                src="{% if context.exports.company_information.properties.logo != blank %}{{context.exports.company_information.properties.logo | asset_url}}{% else %}https://flowbite.com/docs/images/logo.svg{% endif %}"
                alt="{{context.exports.company_information.properties.company_name}} logo">

              <img
                class="hidden h-8 w-auto dark:block"
                src="{% if context.exports.company_information.properties.logo_white != blank %}{{context.exports.company_information.properties.logo_white | asset_url}}{% else %}https://flowbite.com/docs/images/logo.svg{% endif %}"
                alt="{{context.exports.company_information.properties.company_name}} logo">
            </a>

            <div class="mb-8" data-motion-text>
              <div class="mb-3 text-sm font-medium text-primary-600 dark:text-primary-400">
                Welcome back
              </div>

              <h1 class="text-3xl font-semibold tracking-tight text-base-900 dark:text-white md:text-4xl">
                Sign in to your account
              </h1>

              <p class="mt-3 max-w-md text-sm leading-6 text-base-600 dark:text-base-400">
                Enter your details below to access your account.
              </p>
            </div>

            <div class="" data-motion-card>

              {% if context.current_user.id == blank %}

                {% form html_class: 'space-y-5 text-left' -%}

                  <div>
                    <label for="email" class="mb-2 block text-sm font-medium text-base-900 dark:text-white">
                      Your email
                    </label>

                    <input
                      name="{{ form_builder.fields.email.name }}"
                      class="w-full"
                      type="text"
                      placeholder="john@example.com"
                      autocomplete="email"
                      id="email">
                  </div>

                  <div>
                    <label for="password" class="mb-2 block text-sm font-medium text-base-900 dark:text-white">
                      Your password
                    </label>

                    <input
                      id="password"
                      class="w-full"
                      type="password"
                      placeholder="Password"
                      name="{{ form_builder.fields.password.name }}"
                      autocomplete="current-password"
                      aria-label="password">
                  </div>

                  <div class="flex justify-end">
                    <a class="text-sm font-medium text-primary-600 hover:underline dark:text-primary-400" href="/system/recover-password">
                      Lost Password?
                    </a>
                  </div>

                  <div class="hidden rounded-xl bg-danger-100 p-4 text-sm text-danger-700 dark:bg-danger-200 dark:text-danger-800 form-error" role="alert">
                    <!-- Siteglide error message goes here -->
                  </div>

                  <button
                    type="button"
                    class="button w-full"
                    onclick="siteglide_login_process(this,'{{_redirect}}','{{_empty_error_msg}}')">
                    Log In
                  </button>

                  <div class="flex flex-col items-center justify-center gap-2 pt-1 text-sm sm:flex-row">
                    <span class="text-base-600 dark:text-base-400">
                      Don't have an account?
                    </span>

                    <a class="font-medium text-primary-600 hover:underline dark:text-primary-400" href="{{sign_up_url}}">
                      Create Account
                    </a>
                  </div>

                {% endform -%}

              {% else %}

                <div class="rounded-xl bg-warning-100 p-4 text-sm text-warning-700 dark:bg-warning-200 dark:text-warning-800" role="alert">
                  <span class="font-medium">You're already logged in.</span>
                </div>

                <div class="mt-5 flex flex-col gap-3 ">
                  <a
                    class="button-secondary inline-flex w-full items-center justify-center"
                    onclick="history.back()"
                    href="javascript: void(0);">
                    Back
                  </a>

                  {% form -%}
                    <button
                      type="button"
                      class="button inline-flex w-full items-center justify-center"
                      onclick="siteglide_logout_process(this,'{{context.location.pathname}}')">
                      Log Out
                    </button>
                  {% endform -%}
                </div>

              {% endif %}

            </div>

          </div>
        </div>

      </div>
    </div>
  </div>
</section>