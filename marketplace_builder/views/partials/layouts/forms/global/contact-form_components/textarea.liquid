{% if attributes contains 'data-sg-rich-text' %}
  {% comment %} Inside is the JS powered rich text interface which is intialised when the textarea comes into view. {% endcomment %}
  <div data-fb-mde="{{field_id}}">
    {% include "modules/module_357/front_end/v1/flowbite_rich_text"
      , name: name
      , id: field_id
      , label: label
      , value: value
      , validation: validation
      , attributes: attributes
      , wrapper_class: nil
      , readonly_class: nil
      , label_class: nil
      , readonly: false %}
  </div>
{% else %}
  <div class="col-span-full">
    <div class="">
      <label class="block mb-2 text-sm font-medium text-gray-900 dark:text-gray-300" for="{{field_id}}">{{ label }}
        {% if validation contains 'required' %}
          <span>*</span>
        {% endif %}
      </label>
      <textarea
        {{ attributes }}
        id="{{field_id}}"
        name="{{name}}"
        {% if label != blank %}
        data-sg-validation-label="{{label}}"
        data-sg-validation-id="{{field_id}}"
        {% endif %}
        class="{{validation}} {% if validation != blank %}focus:ring-info-500 focus:border-info-500 dark:placeholder-gray-400 dark:focus:ring-info-500 dark:focus:border-info-500 valid:bg-success-50 valid:border-success-500 valid:text-success-900 valid:placeholder-success-700 valid:focus:ring-success-500 valid:focus:border-success-500 dark:valid:bg-gray-700 dark:valid:border-success-400 group-focus-within:invalid:bg-danger-50 group-focus-within:invalid:border-danger-500 group-focus-within:invalid:text-danger-900 group-focus-within:invalid:placeholder-danger-700 group-focus-within:invalid:focus:ring-danger-500 dark:group-focus-within:invalid:bg-gray-700 dark:group-focus-within:invalid:focus:border-danger-500 dark:group-focus-within:invalid:text-danger-500 dark:group-focus-within:invalid:placeholder-danger-500 dark:group-focus-within:invalid:border-danger-500{% endif %}"
        type="text"
        {{ validation }}
        placeholder="Your {{label}}">{{ value }}</textarea>
    </div>
  </div>
{% endif %}