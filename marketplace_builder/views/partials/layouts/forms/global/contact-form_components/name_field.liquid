<div class="{% if context.current_user.id != blank and hide_name_while_logged_in == 'true' %} absolute w-0 h-0 invisible  {% endif %}">
  <div class="">
    <label class="block mb-2 text-sm font-medium text-gray-900 dark:text-gray-300" for="s_name">Name *</label>
    <input
      required
      type="text"
      id="s_name"
      placeholder="Your Full Name"
      class="focus:ring-info-500 focus:border-info-500 dark:placeholder-gray-400 dark:focus:ring-info-500 dark:focus:border-info-500 valid:bg-success-50 valid:border-success-500 valid:text-success-900 valid:placeholder-success-700 valid:focus:ring-success-500 valid:focus:border-success-500 dark:valid:bg-gray-700 dark:valid:border-success-400 group-focus-within:invalid:bg-danger-50 group-focus-within:invalid:border-danger-500 group-focus-within:invalid:text-danger-900 group-focus-within:invalid:placeholder-danger-700 group-focus-within:invalid:focus:ring-danger-500 dark:group-focus-within:invalid:bg-gray-700 group-focus-within:invalid:focus:border-danger-500 dark:group-focus-within:invalid:text-danger-500 dark:group-focus-within:invalid:placeholder-danger-500 dark:group-focus-within:invalid:border-danger-500"
      name="{{name}}"
      {% if context.exports.is_logged_in.data -%}
      readonly
      value="{{ session.current_user.name }}"
      {% endif %}>
  </div>
</div>