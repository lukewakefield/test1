	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/basecoat-css@1.0.2/dist/basecoat.cdn.min.css">
	<style>
		body {
			font-family: Geist, "Geist Sans", ui-sans-serif, system-ui, sans-serif;
			background: var(--background);
			color: var(--foreground);
		}
		.bc-sidebar, .bc-main, .bc-main h1, .bc-main h2, .bc-main h3, .bc-sidebar a {
			font-family: Geist, "Geist Sans", ui-sans-serif, system-ui, sans-serif;
		}
		.bc-sidebar { position: static; width: 100%; height: auto; }
		.bc-main { margin-inline-start: 0; }
        .bc-main { color: var(--foreground); }
        .bc-main > div > section { background: transparent; scroll-margin-top: 2rem; }
        .bc-main h1, .bc-main h2, .bc-main h3 { color: var(--foreground); }
        .bc-main p { color: var(--muted-foreground); }
        .bc-sidebar { background: var(--sidebar); color: var(--sidebar-foreground); }
        .bc-sidebar a { color: var(--sidebar-foreground); }
        .bc-sidebar p { color: var(--muted-foreground); }
        .bc-sidebar a[aria-current] { background: var(--sidebar-accent); color: var(--sidebar-accent-foreground); }
        .bc-sidebar a:hover { background: var(--sidebar-accent); }
        .bc-sidebar-controls { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
        .bc-main .table-container { overflow-x: auto; }
        .bc-main .table { font-variant-numeric: tabular-nums; }
        .bc-main input, .bc-main textarea, .bc-main label { color: var(--foreground); }
        .bc-main .card { background: var(--card); color: var(--card-foreground); }
        .bc-main .card > section { background: transparent; }
        .bc-main .btn, .bc-main .badge { font-family: inherit; }
		.bc-main h1 { font-size: 1.875rem; font-weight: 600; letter-spacing: -0.025em; line-height: 1.15; }
		.bc-main h2 { font-size: 1.25rem; font-weight: 600; letter-spacing: -0.025em; line-height: 1.3; }
		@media (min-width: 48rem) {
			.bc-sidebar {
				position: fixed;
				inset-block: 0;
				inset-inline-start: 0;
				z-index: 30;
				width: 16rem;
				height: 100svh;
				overflow: auto;
				border-inline-end: 1px solid var(--border);
				background: var(--sidebar);
			}
			.bc-main { margin-inline-start: 16rem; }
		}
	</style>
	<script src="https://cdn.jsdelivr.net/npm/basecoat-css@1.0.2/dist/js/all.min.js" defer></script>
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      var sidebar = document.querySelector('.bc-sidebar');
      var main = document.querySelector('.bc-main');
      if (!sidebar || !main) return;
      var links = Array.from(sidebar.querySelectorAll('a[href^="#bc-"]'));
      function activate(id) {
        links.forEach(function (link) {
          if (link.hash === '#' + id) link.setAttribute('aria-current', 'location');
          else link.removeAttribute('aria-current');
        });
      }
      function fromHash() {
        var id = location.hash.slice(1);
        activate(document.getElementById(id) ? id : 'bc-intro');
      }
      fromHash();
      window.addEventListener('hashchange', fromHash);
      if ('IntersectionObserver' in window) {
        var positions = new Map();
        var observer = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) { positions.set(entry.target.id, entry.isIntersecting); });
          var first = Array.from(main.querySelectorAll('[id^="bc-"]')).find(function (panel) { return positions.get(panel.id); });
          if (first) activate(first.id);
        }, { rootMargin: '0px 0px -55% 0px' });
        main.querySelectorAll('header[id^="bc-"], section[id^="bc-"]').forEach(function (panel) { observer.observe(panel); });
      }
    });
  </script>
</body>

